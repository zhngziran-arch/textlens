  "info": {
    "data": {
      "id": "INFO-DATA",
      "label": "具体数据",
      "target": 4,
      "basis": "可核实的数字、百分比、金额、时长、倍数等硬信息。",
      "patterns": [
        "\\d+(?:\\.\\d+)?\\s*(?:%|％|万|亿|元|块|岁|倍|公里|小时|分钟|秒|天|周|个月|年|人|次|篇|个|斤|kg|km|GB|MB|w)",
        "[一二三四五六七八九十百千万]+(?:万|亿)(?:元|人|次)?"
      ]
    },
    "time": {
      "id": "INFO-TIME",
      "label": "时间锚点",
      "target": 1.5,
      "basis": "具体年月日或明确时间节点，让叙事具备真实时空坐标。",
      "patterns": [
        "\\d{4}年",
        "\\d{1,2}月\\d{1,2}[日号]",
        "去年|今年|前年|上周|上个月|昨天|前天|那天|那年|当天|本周|月初|月底"
      ]
    },
    "source": {
      "id": "INFO-SRC",
      "label": "信源出处",
      "target": 1.5,
      "basis": "明确引用的书名、报告、论文、财报或原话引述。",
      "patterns": [
        "《[^》]{1,40}》",
        "据[^，。]{1,20}(?:报道|统计|数据|显示|介绍|披露)",
        "(?:研究|报告|调查|数据|财报|论文|白皮书)(?:显示|指出|表明|提到)",
        "https?://[^\\s，。]+",
        "“[^”]{6,80}”"
      ]
    },
    "experience": {
      "id": "INFO-EXP",
      "label": "第一人称亲历",
      "target": 1.5,
      "basis": "作者亲身实测、踩坑或身边真实人物交集，是算法最看重的独创增量。",
      "patterns": [
        "我(?:曾|去年|前年|那天|当时|上周|昨天|亲自|实测|测试了|试了|用了|买了|去了|问了|做了|花了|踩过|算了笔账|发现)",
        "我(?:的)?(?:朋友|同事|老板|客户|爸|妈|孩子|老婆|老公|室友|同学|团队|读者)",
        "我在[^，。]{1,10}(?:工作|上班|读书|待过|做过|试过)"
      ]
    },
    "case": {
      "id": "INFO-CASE",
      "label": "具象案例",
      "target": 1.5,
      "basis": "具体举例、真实场景还原或正反对比实验。",
      "patterns": [
        "比如|例如|举个例子|举例来说|有一次|案例|以[^，。]{1,10}为例|就拿[^，。]{1,10}来说|打个比方"
      ]
    }
  },
